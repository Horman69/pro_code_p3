# Environment Variables для Vercel

# Telegram Bot Configuration
# Получить BOT_TOKEN: https://t.me/BotFather (команда /newbot)
# Получить CHAT_ID: отправь сообщение боту, потом зайди на https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Примечание: В Vercel Dashboard добавь эти переменные в Settings → Environment Variables
